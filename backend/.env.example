# Supabase Connection settings
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# API server
PORT=8000
ENV=development

# Comma-separated browser origins allowed to call the API when ENV != development
CORS_ORIGINS=

# Server-side only. The browser calls /api/ai/* instead.
GEMINI_API_KEY=

# Whether a tournament's owner is the only admin who may manage it. Turning it
# off lets ANY admin account manage, score and delete EVERY tournament.
ENFORCE_TOURNAMENT_OWNERSHIP=true
