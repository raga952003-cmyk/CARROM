# Supabase Connection settings
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# API server
PORT=8000
ENV=development

# Comma-separated browser origins allowed to call the API when ENV != development
CORS_ORIGINS=

# Server-side only. The browser calls /api/ai/* instead.
GEMINI_API_KEY=

# Razorpay. Test pair (rzp_test_*) for development, live pair (rzp_live_*) in
# production. The key_secret is server-side only and must never be prefixed
# VITE_ or otherwise exposed to the browser.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set when creating the webhook in the Razorpay dashboard. Not the same value
# as RAZORPAY_KEY_SECRET, and different again between test and live.
RAZORPAY_WEBHOOK_SECRET=

# Optional receipt OCR. When set, image receipts are sent from the backend to
# Google Cloud Vision to read transaction text; bank credit still needs review.
PAYMENT_PROOF_VISION_API_KEY=

# Whether a tournament's owner is the only admin who may manage it. Turning it
# off lets ANY admin account manage, score and delete EVERY tournament.
ENFORCE_TOURNAMENT_OWNERSHIP=true
